        if (g.rules !== undefined) body.rules = g.rules;
        const result = await create("/firewalls", body, g.token) as ResourceData;
        const instanceName = (g.name?.toString() ?? "current").replace(/[\\\\/\\\\\\\\]/g, "_").replace(/\\\\.\\\\./g, "_").replace(/\\\\0/g, "");
